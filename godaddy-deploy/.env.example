# Local development only. GoDaddy production values belong in cPanel's Node.js
# application environment variables; production does not require a .env file.
PORT=3000
NODE_ENV=production
SESSION_SECRET=
SECURE_COOKIES=true

# GoDaddy injects these Hosted Database values automatically.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Absolute path to persistent asset storage. Production defaults to
# /private/pictureday; local development defaults under public/assets.
PICTUREDAY_ASSET_DIR=

# Email sends use the local GoDaddy email gateway; no SMTP variables are required.

# Optional Published hostname override; accepts a hostname or URL. If unset, the
# configured family-facing public URL is used. Preview and other hosts are rejected.
PARENT_EMAIL_PUBLISHED_HOST=
