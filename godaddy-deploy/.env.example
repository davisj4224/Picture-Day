# Local development only. GoDaddy production values belong in cPanel's Node.js
# application environment variables; production does not require a .env file.
PORT=3000
NODE_ENV=production
SESSION_SECRET=
SECURE_COOKIES=true

# Required GoDaddy Managed MySQL connection values.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
# Optional pool tuning; the default connection limit is 10.
MYSQL_CONNECTION_LIMIT=10

# Absolute path to GoDaddy's persistent public/assets directory. If unset,
# uploads are written under godaddy-deploy/public/assets/pictureday.
PICTUREDAY_ASSET_DIR=

# Existing mail integration configuration.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Picture Day <support@calcharterpicts.org>"
