# Copy this file to ".env" and fill it in. Never commit the real .env.

# Port the server listens on.
PORT=3000

# Optional persistent storage root. Leave unset for the legacy local layout.
# After copying and reviewing existing data, GoDaddy Node.js Hosting can use:
# PD_STORAGE_ROOT=/private/picture-day
# The database must already exist there or the app will refuse to start.

# GoDaddy Node.js Hosting should use the production environment.
NODE_ENV=production

# Required. Long random string — sessions are signed with it.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Set to true only when the site is served over HTTPS.
SECURE_COOKIES=false

# ---------------------------------------------------------------- email
# Leave SMTP_HOST empty to keep email switched off. The app then lets you
# export gallery links as a CSV and send them through the school's own
# mail system instead — which is usually the easier approval to get.

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Picture Day <support@calcharterpicts.org>"
